# Copy to .env and replace every "change-me" value before running
# `docker compose up -d`. Never commit .env.

# API server listen address. Keep it on loopback until authentication exists.
FLOWSENTINEL_API_ADDR=127.0.0.1:8080
# Log verbosity (tracing EnvFilter syntax), e.g. info, debug, api_server=debug
RUST_LOG=info

# PostgreSQL connection used by the API server. Keep the user, password, port
# and database in sync with the POSTGRES_* values below. Use a password of
# letters and digits so it needs no URL encoding.
FLOWSENTINEL_DATABASE_URL=postgres://flowsentinel:change-me@127.0.0.1:5432/flowsentinel
# Optional API limits (defaults shown).
# FLOWSENTINEL_MAX_UPLOAD_MB=512
# FLOWSENTINEL_MAX_CONCURRENT_IMPORTS=2
# FLOWSENTINEL_DB_MAX_CONNECTIONS=10
# FLOWSENTINEL_QUERY_TIMEOUT_SECONDS=10
# FLOWSENTINEL_UPLOAD_DIR=          # default: the system temporary directory
# FLOWSENTINEL_MAX_PACKETS=1000000
# FLOWSENTINEL_MAX_ANALYSIS_SECONDS=600
# Host names clients use to reach the API, besides localhost (comma-separated, or *).
# FLOWSENTINEL_ALLOWED_HOSTS=

# PostgreSQL (started by Docker Compose)
POSTGRES_USER=flowsentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flowsentinel
POSTGRES_PORT=5432

# Redis (started by Docker Compose; not used by the code yet)
REDIS_PASSWORD=change-me
REDIS_PORT=6379
