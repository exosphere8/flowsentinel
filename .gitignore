# Rust build output
target/
**/*.rs.bk

# Environment files: never commit secrets. Only the template is tracked.
.env
.env.*
!.env.example

# Packet captures: may contain sensitive traffic. Synthetic fixtures under
# fixtures/ are explicitly re-included below. Patterns are case-insensitive
# because FlowSentinel accepts .PCAP as well as .pcap.
*.[pP][cC][aA][pP]
*.[pP][cC][aA][pP][nN][gG]
*.[cC][aA][pP]
!fixtures/**/*.[pP][cC][aA][pP]
!fixtures/**/*.[pP][cC][aA][pP][nN][gG]

# Python bytecode (fixture generator)
__pycache__/

# Logs
*.log
logs/

# Local databases and dumps
*.db
*.sqlite
*.sqlite3
*.dump
pgdata/

# Frontend dependencies and build artifacts
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/test-results/
frontend/playwright-report/
coverage/

# Editors and OS artifacts
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
